# 必填：用于签发 access JWT 并派生服务端会话密钥，生产环境请使用至少 32 字符的随机长字符串
# 生成方式：openssl rand -hex 32
JWT_SECRET=

# 必填：部署的镜像标签。生产环境使用 sha-<commit sha>，不要使用 latest
FINARCH_IMAGE_TAG=

# 可选：数据库路径（默认 /data/finarch.db）
# FINARCH_DB=/data/finarch.db

# 可选：生产 server 监听地址（默认 0.0.0.0:8080；CLI serve 始终仅允许回环地址）
# FINARCH_ADDR=0.0.0.0:8080

# 可选：生产 HTTP 生命周期限制。30m 的读/写窗口用于 100 MiB 恢复、备份与长耗时 OCR；
# 反向代理的请求体和 upstream 超时不得短于这些值。关闭宽限期内会等待在途请求完成。
# FINARCH_HTTP_READ_HEADER_TIMEOUT=10s
# FINARCH_HTTP_READ_TIMEOUT=30m
# FINARCH_HTTP_WRITE_TIMEOUT=30m
# FINARCH_HTTP_IDLE_TIMEOUT=2m
# FINARCH_HTTP_SHUTDOWN_TIMEOUT=5m
# FINARCH_HTTP_MAX_HEADER_BYTES=65536

# 生产浏览器会话固定使用 __Host-finarch_refresh（HttpOnly、Secure、SameSite=Strict、Path=/）。
# access token 有效期 15 分钟；refresh 滑动有效期 7 天、绝对有效期 30 天，轮换重试宽限期 10 秒。
# 浏览器登录、注册、刷新和登出必须与 API 严格同源；生产环境必须由 HTTPS 反向代理保留原始 Host。
# 只有绑定回环地址的 `go run ./cmd/cli serve` 可使用非 Secure 的开发 cookie。

# 系统级整库导出/恢复默认关闭。仅限受控维护窗口开启；secret 至少 32 字符且不得复用 JWT_SECRET。
# 请求还必须提供 X-FinArch-Operations-Secret header。
# 该 secret 只能进入受控 CLI/运维客户端，绝不能进入浏览器、前端环境变量或 localStorage。
# FINARCH_ENABLE_SYSTEM_OPERATIONS=false
# FINARCH_SYSTEM_OPERATIONS_SECRET=
# 直接运行 cmd/server 时默认不在代理后并忽略所有转发 IP header；若自行置于代理后，必须显式设为 true。
# Docker Compose 固定 FINARCH_BEHIND_PROXY=true，因此下方完整可信代理链为必填项，否则 Compose 拒绝展开。
# 列出应用实际看到的直连代理，以及 X-Forwarded-For 中真实客户端右侧的每个受控中间代理。
# 使用最窄的 /32、/128 或代理商正式 CIDR；不得填写客户端地址空间、全部私网或不受控网段，
# 且应用会拒绝 0.0.0.0/0 和 ::/0。公网边缘代理必须覆盖/清洗客户端自带的转发头。
# FINARCH_BEHIND_PROXY=false
FINARCH_TRUSTED_PROXY_CIDRS=
# 跨域默认关闭；如确需 bearer API 跨域，填写逗号分隔的完整 Origin（含 scheme 和端口）。
# CORS 不允许 credentials，也不支持跨域 cookie 会话；请勿据此开放 Access-Control-Allow-Credentials。
# FINARCH_CORS_ALLOWED_ORIGINS=https://app.example.com

# 可选：SQLite 连接池调优（默认适合 WAL 单实例部署）
# FINARCH_DB_MAX_OPEN_CONNS=8
# FINARCH_DB_MAX_IDLE_CONNS=4
# FINARCH_DB_CONN_MAX_IDLE_TIME=5m
# FINARCH_DB_CONN_MAX_LIFETIME=30m
# 仅供 Docker Compose：备份/恢复临时空间上限，默认 512m；提高前确认主机内存充足。
# FINARCH_TMPFS_SIZE=512m

# 可选：周期交易自动生成（默认启用，每 15 分钟扫描一次）
# FINARCH_RECURRING_AUTORUN=true
# FINARCH_RECURRING_INTERVAL=15m
# FINARCH_RECURRING_BATCH_LIMIT=100
# FINARCH_RECURRING_DRY_RUN=false

# 可选：附件和 OCR
# FINARCH_ATTACHMENTS_DIR=/data/attachments
# FINARCH_ATTACHMENT_MAX_BYTES=20971520
# FINARCH_ATTACHMENT_MAX_FILES_PER_USER=500
# FINARCH_ATTACHMENT_MAX_TOTAL_BYTES_PER_USER=1073741824
# FINARCH_ATTACHMENT_UPLOADS_PER_MINUTE=30
# 未关联交易且超过 TTL 的附件会先进入耐久删除队列，再清理元数据
# FINARCH_ATTACHMENT_ORPHAN_TTL=24h
# FINARCH_ATTACHMENT_ORPHAN_CLEANUP_INTERVAL=1h
# FINARCH_ATTACHMENT_ORPHAN_CLEANUP_BATCH_SIZE=100
# FINARCH_OCR_PROVIDER=none
# 可选值：none（关闭）、paddle（HTTP sidecar）、paddle_aistudio（PaddleOCR AIStudio 云 API）
# FINARCH_OCR_URL=http://ocr:8000/ocr
# FINARCH_OCR_TIMEOUT=45s
# FINARCH_OCR_LANG=ch
# PaddleOCR AIStudio（仅当 FINARCH_OCR_PROVIDER=paddle_aistudio 时需要）
# 请只在服务器 .env 中填写真实 token，不要提交到 Git。
# FINARCH_OCR_AISTUDIO_TOKEN=
# FINARCH_OCR_AISTUDIO_MODEL=PaddleOCR-VL-1.6
# FINARCH_OCR_AISTUDIO_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
# FINARCH_OCR_AISTUDIO_OPTIONAL_PAYLOAD={"useDocOrientationClassify":false,"useDocUnwarping":false,"useChartRecognition":false}
# FINARCH_OCR_AISTUDIO_POLL_INTERVAL=5s
# FINARCH_OCR_AISTUDIO_MAX_RESULT_BYTES=10485760
# 逗号分隔；默认仅允许与 JOB_URL 相同的 host。若云 API 返回其他对象存储 host，必须显式加入。
# FINARCH_OCR_AISTUDIO_ALLOWED_RESULT_HOSTS=
# FINARCH_OCR_MAX_CONCURRENT_PER_USER=1
# FINARCH_OCR_MAX_CONCURRENT_GLOBAL=4
# FINARCH_OCR_MAX_RUNS_PER_HOUR=20

# 可选：Cloudflare Turnstile 人机验证
# 前往 https://dash.cloudflare.com/?to=/:account/turnstile 创建站点获取密钥
# 留空则禁用验证（适合内网/本地部署）
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=
